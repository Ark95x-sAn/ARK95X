# ============================================
# ARK95X Environment Configuration
# Copy this file to .env and update values
# ============================================

# --- Ollama Configuration ---
OLLAMA_HOST=http://ollama:11434
BENCHMARK_MODELS=gemma4,llama3,mistral

# --- n8n Workflow Engine ---
# n8n:latest uses user management, not basic-auth env vars.
# Generate N8N_ENCRYPTION_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
# Complete owner setup only on localhost after first start.
WEBHOOK_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=

# --- Comet Router ---
# Required. Router refuses to start on a missing or placeholder token.
COMET_ROUTER_TOKEN=

# --- Toast POS Audit ---
VOID_THRESHOLD=5.0
COMP_THRESHOLD=3.0
ALERT_WEBHOOK=

# --- Watchdog ---
CHECK_INTERVAL=300

# --- Logging ---
LOG_LEVEL=INFO

# --- Dashboard ---
DASHBOARD_PORT=8501
